# Python
.venv/
__pycache__/
*.py[cod]

# Run transcripts (reproducible noise; traceable evidence lives in
# calibration/data/, results/, simulator/validation_runs/)
*.log
# Exception: results/paper logs ARE the evidence (KV-pool trajectories,
# run/wait queue states, SM-util samples backing the E1 crash analysis)
!results/paper/**/*.log

# OS / editor
.DS_Store
*.swp

# .context: keep digests/notes in git; large binaries stay local-only
.context/**/*.pdf
.context/**/*.pptx
.context/papers/**/*.log
.context/papers/.digest-logs/
